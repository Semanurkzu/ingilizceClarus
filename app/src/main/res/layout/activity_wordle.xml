<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FDEFF2"
    android:padding="16dp">

    <!-- Üst Bar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clarus Wordle"
        android:textColor="#7D2039"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <!-- Oyun Durumu (Kalan Hak vb.) -->
    <TextView
        android:id="@+id/tvGameStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#A62B4B"
        android:gravity="center"
        android:textSize="18sp"
        android:layout_marginBottom="10dp"/>

    <!-- Oyun Tahtası (Kutuların Alt Alta Ekleneceği Yer) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/llGameBoard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="10dp"/>

    </ScrollView>

    <!-- Kullanıcı Giriş Alanı (Yazmalı Kısım) -->
    <EditText
        android:id="@+id/etTahmin"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="5 HARFLİ KELİME"
        android:textColor="#7D2039"
        android:textColorHint="#888888"
        android:maxLength="5"
        android:inputType="textCapCharacters"
        android:gravity="center"
        android:backgroundTint="#7D2039"
        android:textSize="20sp"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnTahminEt"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="TAHMİN ET"
        android:backgroundTint="#A62B4B"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

</LinearLayout>
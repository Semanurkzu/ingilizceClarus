<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121213"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CLARUS WORDLE"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <GridLayout
        android:id="@+id/wordleGrid"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="5"
        android:rowCount="6"
        android:layout_gravity="center"
        android:useDefaultMargins="true">
        <!-- Java kodunda dinamik olarak dolacak -->
    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center">

        <EditText
            android:id="@+id/etTahmin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="5 harf giriniz"
            android:textColor="#FFFFFF"
            android:textColorHint="#818384"
            android:maxLength="5"
            android:inputType="textCapCharacters"
            android:backgroundTint="#3A3A3C"/>

        <Button
            android:id="@+id/btnTahminEt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GİR"
            android:backgroundTint="#538D4E"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
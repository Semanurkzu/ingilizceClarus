<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDEFF2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Story Chain (AI)"
            android:textColor="#7D2039"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- Kullanıcının kelimeleri gireceği alanlar -->
        <EditText
            android:id="@+id/etWord1"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="1. Kelimeyi Yazın"
            android:backgroundTint="#A62B4B"
            android:textColor="#3A3A3C"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etWord2"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="2. Kelimeyi Yazın"
            android:backgroundTint="#A62B4B"
            android:textColor="#3A3A3C"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etWord3"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="3. Kelimeyi Yazın"
            android:backgroundTint="#A62B4B"
            android:textColor="#3A3A3C"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etWord4"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="4. Kelimeyi Yazın"
            android:backgroundTint="#A62B4B"
            android:textColor="#3A3A3C"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etWord5"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="5. Kelimeyi Yazın"
            android:backgroundTint="#A62B4B"
            android:textColor="#3A3A3C"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnOlustur"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="HİKAYE VE GÖRSEL OLUŞTUR"
            android:backgroundTint="#7D2039"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvHikaye"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#3A3A3C"
            android:textSize="16sp"
            android:layout_marginBottom="20dp"/>

        <ImageView
            android:id="@+id/ivGorsel"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="fitCenter"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>
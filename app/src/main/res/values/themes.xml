<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Ana Tema -->
    <style name="Base.Theme.Clarus" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/visne_detay</item>
        <item name="android:statusBarColor">@color/arka_plan_pudra</item>
    </style>

    <style name="Theme.Clarus" parent="Base.Theme.Clarus" />

    <!-- Senin Aranan Stillerin (BURASI ÇOK KRİTİK) -->

    <style name="MenuKartiStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">160dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">10dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="IcerikStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="IkonStyle">
        <item name="android:layout_width">45dp</item>
        <item name="android:layout_height">45dp</item>
        <item name="android:tint">@color/visne_detay</item>
    </style>

    <style name="MetinStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/yazi_koyu_pembe</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
</resources>